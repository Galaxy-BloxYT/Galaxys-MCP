        local newPos = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )

        MainFrame.Position = newPos
        Shadow.Position = newPos
    end
end)

-- RESPONSIVE SCALE FOR SMALLER SCREENS
local UIScale = Instance.new("UIScale")
UIScale.Scale = 1
UIScale.Parent = MainFrame

local ShadowScale = Instance.new("UIScale")
ShadowScale.Scale = 1
ShadowScale.Parent = Shadow

local viewportConnection

local function updateScale()
    local camera = workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)

    -- Leave a safe margin on every side and scale the whole window proportionally.
    local safeWidth = math.max(220, viewport.X - 24)
    local safeHeight = math.max(260, viewport.Y - 24)
    local widthScale = safeWidth / 660
    local heightScale = safeHeight / 510
    local scale = math.min(1, widthScale, heightScale)

    -- Supports very small phone/VR viewports instead of stopping at 68%.
    scale = math.clamp(scale, 0.42, 1)
    currentUiScale = scale
    UIScale.Scale = scale
    ShadowScale.Scale = scale

    task.defer(function()
        updateMessageCanvas()
    end)

    -- Keep the window centered after viewport/orientation changes.
    if not dragging then
        MainFrame.Position = UDim2.fromScale(0.5, 0.5)
        Shadow.Position = UDim2.fromScale(0.5, 0.5)
    end
end

local function bindViewport()
    if viewportConnection then
        viewportConnection:Disconnect()
        viewportConnection = nil
    end

    local camera = workspace.CurrentCamera
    if camera then
        viewportConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
    end
    updateScale()
end

bindViewport()
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindViewport)


-- LOAD SAVED CHAT FROM SUPABASE
do
    Subtitle.Text = "Loading saved chat..."
    StatusDot.BackgroundColor3 = Color3.fromRGB(246, 190, 73)

    local ok, info = loadMessagesFromSupabase()

    if ok then
        local restored = 0
        suppressAutoScroll = true

        for i = 2, #chatHistory do
            local item = chatHistory[i]

            if item.role == "user" then
                createMessage("user", item.content)
                restored += 1
            elseif item.role == "assistant" then
                -- Never re-run old //autoexecute blocks while restoring history.
                createAssistantResponse(item.content, nil, {
                    allowAutoExecute = false,
                })
                restored += 1
            end

            -- Avoid freezing the UI while restoring a large saved conversation.
            if restored > 0 and restored % 25 == 0 then
                task.wait()
            end
        end

        suppressAutoScroll = false
        updateMessageCanvas()
        scrollToBottom()

        if restored == 0 then
            createMessage(
                "assistant",
                "Hey! I'm using OpenRouter free models. This chat is now saved in Supabase and restored when you reopen it."
            )
        end

        Subtitle.Text = MODEL .. "  •  Ready • Saved"
        StatusDot.BackgroundColor3 = Theme.Success
    else
        suppressAutoScroll = false
        warn("[OpenRouterChat] Supabase history load failed:", info)
        createMessage(
            "MCP AI • Official",
            "Supabase history could not be loaded, so this session started locally. Error: " .. tostring(info)
        )
        Subtitle.Text = MODEL .. "  •  Ready • Local"
        StatusDot.BackgroundColor3 = Theme.Success
    end
end

