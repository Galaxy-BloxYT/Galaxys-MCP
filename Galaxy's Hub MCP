local function getRequestFunc()
    return request or http_request or (http and http.request) or (syn and syn.request)
end

local function supabaseHeaders(prefer)
    local headers = {
        ["Content-Type"] = "application/json",
        ["apikey"] = SUPABASE_ANON_KEY,
        ["Authorization"] = "Bearer " .. SUPABASE_ANON_KEY,
    }

    if prefer then
        headers["Prefer"] = prefer
    end

    return headers
end

local function saveMessageToSupabase(role, content)
    local requestFunc = getRequestFunc()
    if not requestFunc then
        return false, "HTTP request API unavailable"
    end

    local payload = {
        roblox_user_id = LocalPlayer.UserId,
        conversation_id = CONVERSATION_ID,
        role = tostring(role),
        content = tostring(content),
    }

    local ok, result = pcall(function()
        return requestFunc({
            Url = SUPABASE_URL .. "/rest/v1/" .. SUPABASE_TABLE,
            Method = "POST",
            Headers = supabaseHeaders("return=minimal"),
            Body = HttpService:JSONEncode(payload),
        })
    end)

    if not ok or not result then
        return false, tostring(result)
    end

    local statusCode = tonumber(result.StatusCode or result.status)
    if not statusCode or statusCode < 200 or statusCode >= 300 then
        return false, "HTTP " .. tostring(statusCode) .. ": " .. tostring(result.Body or result.body)
    end

    return true
end

local function loadMessagesFromSupabase()
    local requestFunc = getRequestFunc()
    if not requestFunc then
        return false, "HTTP request API unavailable"
    end

    local allRows = {}
    local offset = 0

    while true do
        local url = SUPABASE_URL
            .. "/rest/v1/" .. SUPABASE_TABLE
            .. "?select=id,role,content,created_at"
            .. "&roblox_user_id=eq." .. tostring(LocalPlayer.UserId)
            .. "&conversation_id=eq." .. HttpService:UrlEncode(CONVERSATION_ID)
            .. "&order=created_at.asc,id.asc"
            .. "&limit=" .. tostring(SUPABASE_PAGE_SIZE)
            .. "&offset=" .. tostring(offset)

        local ok, result = pcall(function()
            return requestFunc({
                Url = url,
                Method = "GET",
                Headers = supabaseHeaders(),
            })
        end)

        if not ok or not result then
            return false, tostring(result)
        end

        local statusCode = tonumber(result.StatusCode or result.status)
        local body = result.Body or result.body or ""

        if not statusCode or statusCode < 200 or statusCode >= 300 then
            return false, "HTTP " .. tostring(statusCode) .. ": " .. tostring(body)
        end

        local decodeOk, rows = pcall(function()
            return HttpService:JSONDecode(body)
        end)

        if not decodeOk or type(rows) ~= "table" then
            return false, "Unreadable Supabase response"
        end

        for _, row in ipairs(rows) do
            table.insert(allRows, row)
        end

        if #rows < SUPABASE_PAGE_SIZE then
            break
        end

        offset += #rows

        -- Safety against a broken/repeating endpoint.
        if #rows == 0 then
            break
        end
    end

    chatHistory = {
        { role = "system", content = SYSTEM_PROMPT }
    }

    for _, row in ipairs(allRows) do
        if type(row) == "table"
            and (row.role == "user" or row.role == "assistant")
            and type(row.content) == "string"
        then
            table.insert(chatHistory, {
                role = row.role,
                content = row.content,
            })
        end
    end

    return true, #allRows
end

