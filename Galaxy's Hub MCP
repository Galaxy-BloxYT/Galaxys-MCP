-- OpenRouter's "Flag" action is observability-only and is not exposed as a simple
-- flag in the normal chat-completions response, so the UI mirrors common patterns
-- locally purely to display a warning. This does NOT block or modify the request.
local PROMPT_INJECTION_PATTERNS = {
    { pattern = "ignore%s+previous%s+instructions", label = "ignore previous instructions" },
    { pattern = "ignore%s+all%s+previous%s+instructions", label = "ignore all previous instructions" },
    { pattern = "disregard%s+previous%s+instructions", label = "disregard previous instructions" },
    { pattern = "forget%s+previous%s+instructions", label = "forget previous instructions" },
    { pattern = "override%s+previous%s+instructions", label = "override previous instructions" },

    { pattern = "reveal%s+.-system%s+prompt", label = "system prompt extraction" },
    { pattern = "show%s+.-system%s+prompt", label = "system prompt extraction" },
    { pattern = "print%s+.-system%s+prompt", label = "system prompt extraction" },
    { pattern = "what%s+.-system%s+prompt", label = "system prompt extraction" },

    { pattern = "developer%s+message", label = "developer-message extraction" },
    { pattern = "hidden%s+instructions", label = "hidden-instruction extraction" },
    { pattern = "internal%s+instructions", label = "internal-instruction extraction" },

    { pattern = "act%s+as%s+if%s+.-no%s+rules", label = "rule bypass attempt" },
    { pattern = "you%s+are%s+now%s+.-unrestricted", label = "unrestricted-mode attempt" },
    { pattern = "bypass%s+.-safety", label = "safety bypass attempt" },
    { pattern = "disable%s+.-safety", label = "safety bypass attempt" },
    { pattern = "ignore%s+.-safety", label = "safety bypass attempt" },

    { pattern = "do%s+not%s+follow%s+.-instructions", label = "instruction override" },
    { pattern = "instead%s+follow%s+.-instructions", label = "instruction override" },
}

local function detectPromptInjectionFlag(message)
    local normalized = tostring(message or ""):lower()

    -- Normalize whitespace to make simple spacing tricks less effective.
    normalized = normalized:gsub("[%s\r\n\t]+", " ")

    for _, item in ipairs(PROMPT_INJECTION_PATTERNS) do
        if normalized:find(item.pattern) then
            return true, item.label
        end
    end

    return false, nil
end

