local function parseAssistantContent(text)
    text = tostring(text or ""):gsub("\r\n", "\n")
    local segments = {}
    local normalLines = {}
    local codeLines = {}
    local inCode = false
    local codeLanguage = "code"
    local allowCopy = false
    local allowExecute = false
    local autoExecute = false
    local nextAllowCopy = false
    local nextAllowExecute = false
    local nextAutoExecute = false
    local nextLanguage = nil

    local function flushText()
        if #normalLines > 0 then
            local value = table.concat(normalLines, "\n")
            value = value:gsub("^\n+", ""):gsub("\n+$", "")
            if value ~= "" then
                table.insert(segments, { type = "text", text = value })
            end
            table.clear(normalLines)
        end
    end

    local function flushCode()
        local value = table.concat(codeLines, "\n")
        table.insert(segments, {
            type = "code",
            text = value,
            language = codeLanguage ~= "" and codeLanguage or "code",
            allowCopy = allowCopy,
            allowExecute = allowExecute,
            autoExecute = autoExecute,
        })
        table.clear(codeLines)
        codeLanguage = "code"
        allowCopy = false
        allowExecute = false
        autoExecute = false
    end

    for line in (text .. "\n"):gmatch("(.-)\n") do
        local trimmed = line:match("^%s*(.-)%s*$") or line
        local lower = trimmed:lower()

        if not inCode then
            local lang = trimmed:match("^//codestart%s*(.*)$")
            local mdLang = trimmed:match("^```%s*([%w_+%-%.#]*)%s*$")

            if lang ~= nil then
                flushText()
                inCode = true
                codeLanguage = (lang ~= "" and lang) or nextLanguage or "code"
                allowCopy = nextAllowCopy
                allowExecute = nextAllowExecute
                autoExecute = nextAutoExecute
                if autoExecute then
                    allowCopy = false
                    allowExecute = false
                end
                nextAllowCopy = false
                nextAllowExecute = false
                nextAutoExecute = false
                nextLanguage = nil
            elseif mdLang ~= nil then
                flushText()
                inCode = true
                codeLanguage = (mdLang ~= "" and mdLang) or nextLanguage or "code"
                allowCopy = nextAllowCopy
                allowExecute = nextAllowExecute
                autoExecute = nextAutoExecute
                if autoExecute then
                    allowCopy = false
                    allowExecute = false
                end
                nextAllowCopy = false
                nextAllowExecute = false
                nextAutoExecute = false
                nextLanguage = nil
            elseif lower == "//allowcopy" then
                nextAllowCopy = true
            elseif lower == "//nocopy" then
                nextAllowCopy = false
            elseif lower == "//executecode" then
                nextAllowExecute = true
            elseif lower == "//noexecute" then
                nextAllowExecute = false
            elseif lower == "//autoexecute" then
                nextAutoExecute = true
                nextAllowCopy = false
                nextAllowExecute = false
            elseif lower == "//noautoexecute" then
                nextAutoExecute = false
            elseif lower:match("^//language%s+") then
                nextLanguage = trimmed:match("^//language%s+(.+)$") or "code"
            else
                table.insert(normalLines, line)
            end
        else
            if lower == "//codeend" or trimmed == "```" then
                flushCode()
                inCode = false
            elseif lower == "//allowcopy" then
                allowCopy = true
            elseif lower == "//nocopy" then
                allowCopy = false
            elseif lower == "//executecode" then
                allowExecute = true
            elseif lower == "//noexecute" then
                allowExecute = false
            elseif lower == "//autoexecute" then
                autoExecute = true
                allowCopy = false
                allowExecute = false
            elseif lower == "//noautoexecute" then
                autoExecute = false
            elseif lower:match("^//language%s+") then
                codeLanguage = trimmed:match("^//language%s+(.+)$") or codeLanguage
            else
                table.insert(codeLines, line)
            end
        end
    end

    if inCode then
        flushCode()
    end
    flushText()

    if #segments == 0 then
        table.insert(segments, { type = "text", text = text })
    end

    return segments
end


local AUTOEXECUTE_BLOCKED_PATTERNS = {
    "%f[%w_]request%s*%(",
    "%f[%w_]http_request%s*%(",
    "syn%s*%.%s*request",
    "http%s*%.%s*request",
    "game%s*:%s*httpget%s*%(",
    "game%s*:%s*httppost%s*%(",
    "%f[%w_]loadstring%s*%(",
    "%f[%w_]getgenv%s*%(",
    "%f[%w_]getrenv%s*%(",
    "%f[%w_]getfenv%s*%(",
    "%f[%w_]setfenv%s*%(",
    "%f[%w_]hookfunction%s*%(",
    "%f[%w_]hookmetamethod%s*%(",
    "%f[%w_]getrawmetatable%s*%(",
    "%f[%w_]setreadonly%s*%(",
    "%f[%w_]writefile%s*%(",
    "%f[%w_]appendfile%s*%(",
    "%f[%w_]delfile%s*%(",
    "%f[%w_]makefolder%s*%(",
    "%f[%w_]delfolder%s*%(",
    "%f[%w_]setclipboard%s*%(",
    "%f[%w_]toclipboard%s*%(",
}

local function isSafeForAutoExecute(code)
    local lowered = tostring(code or ""):lower()

    for _, pattern in ipairs(AUTOEXECUTE_BLOCKED_PATTERNS) do
        if lowered:find(pattern) then
            return false, pattern
        end
    end

    return true
end

local function executeCodeSafely(code)
    if type(loadstring) ~= "function" then
        return false, "loadstring is not supported in this environment."
    end

    local safe, blocked = isSafeForAutoExecute(code)
    if not safe then
        return false, "Blocked by autoexecute safety filter: " .. tostring(blocked)
    end

    local compileOk, compiled, compileErr = pcall(loadstring, code)
    if not compileOk then
        return false, "Compile call failed: " .. tostring(compiled)
    end
    if type(compiled) ~= "function" then
        return false, "Compile error: " .. tostring(compileErr or compiled)
    end

    local ok, result = pcall(compiled)
    if not ok then
        return false, "Runtime error: " .. tostring(result)
    end

    return true, result
end

