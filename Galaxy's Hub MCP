-- Saved chat is loaded and rendered after all UI/message functions are ready.

local function extractAssistantText(message)
    if type(message) ~= "table" then
        return nil
    end

    if type(message.content) == "string" and message.content ~= "" then
        return message.content
    end

    if type(message.content) == "table" then
        local parts = {}

        for _, part in ipairs(message.content) do
            if type(part) == "string" then
                table.insert(parts, part)
            elseif type(part) == "table" and type(part.text) == "string" then
                table.insert(parts, part.text)
            end
        end

        if #parts > 0 then
            return table.concat(parts, "\n")
        end
    end

    return nil
end

-- OPENROUTER API REQUEST
local function callOpenRouter(prompt)
    local requestFunc = getRequestFunc()

    if not requestFunc then
        return "Error: this environment does not support HTTP requests."
    end

    if OPENROUTER_API_KEY == "" or OPENROUTER_API_KEY == "PASTE_YOUR_OPENROUTER_API_KEY_HERE" then
        return "Error: add your OpenRouter API key to OPENROUTER_API_KEY first."
    end

    prompt = tostring(prompt)

    -- IMPORTANT:
    -- Supabase is the source of truth for conversation memory.
    -- Save the current user turn FIRST, synchronously, then reload the ENTIRE
    -- conversation from Supabase so every OpenRouter request receives all past turns.
    local userSaved, userSaveErr = saveMessageToSupabase("user", prompt)

    if userSaved then
        local loaded, loadInfo = loadMessagesFromSupabase()

        if not loaded then
            warn("[OpenRouterChat] Full-history reload failed:", loadInfo)

            -- Fallback: preserve the current in-memory history.
            table.insert(chatHistory, {
                role = "user",
                content = prompt,
            })
        end
    else
        warn("[OpenRouterChat] Supabase user-message save failed:", userSaveErr)

        -- Do not lose the turn if Supabase is temporarily unavailable.
        table.insert(chatHistory, {
            role = "user",
            content = prompt,
        })
    end

    -- Make a fresh deep-enough API message array.
    -- We intentionally do NOT send a shortened/summarized copy here.
    local apiMessages = {}

    for _, item in ipairs(chatHistory) do
        if type(item) == "table"
            and type(item.role) == "string"
            and type(item.content) == "string"
        then
            table.insert(apiMessages, {
                role = item.role,
                content = item.content,
            })
        end
    end

    local payload = {
        -- Always request the free router. LAST_MODEL is display-only so a routed
        -- base model can never accidentally become a paid follow-up request.
        model = MODEL,
        messages = apiMessages,
    }

    local success, result = pcall(function()
        return requestFunc({
            Url = "https://openrouter.ai/api/v1/chat/completions",
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["Authorization"] = "Bearer " .. tostring(OPENROUTER_API_KEY),
                ["HTTP-Referer"] = "https://www.roblox.com/",
                ["X-Title"] = "Roblox OpenRouter Chat"
            },
            Body = HttpService:JSONEncode(payload)
        })
    end)

    if not success or not result then
        return "Request failed: " .. tostring(result)
    end

    local statusCode = result.StatusCode or result.status
    local responseBody = result.Body or result.body

    if tonumber(statusCode) ~= 200 then
        return "HTTP error (" .. tostring(statusCode) .. "): " .. tostring(responseBody)
    end

    local decodeSuccess, decoded = pcall(function()
        return HttpService:JSONDecode(responseBody)
    end)

    if not decodeSuccess or type(decoded) ~= "table" then
        return "Connected, but OpenRouter returned an unreadable response."
    end

    if type(decoded.model) == "string" and decoded.model ~= "" then
        LAST_MODEL = decoded.model
    end

    local choices = decoded.choices
    if type(choices) == "table" and type(choices[1]) == "table" then
        local message = choices[1].message

        local assistantText = extractAssistantText(message)

        if type(assistantText) == "string" and assistantText ~= "" then

            -- Save synchronously so the NEXT request cannot race ahead of persistence.
            local assistantSaved, assistantSaveErr =
                saveMessageToSupabase("assistant", assistantText)

            if assistantSaved then
                -- Reload again so in-memory history exactly matches persistent history.
                local loaded, loadInfo = loadMessagesFromSupabase()

                if not loaded then
                    warn("[OpenRouterChat] Post-response history reload failed:", loadInfo)
                    table.insert(chatHistory, {
                        role = "assistant",
                        content = assistantText,
                    })
                end
            else
                warn(
                    "[OpenRouterChat] Supabase assistant-message save failed:",
                    assistantSaveErr
                )

                table.insert(chatHistory, {
                    role = "assistant",
                    content = assistantText,
                })
            end

            return assistantText
        end
    end

    return "Connected, but OpenRouter returned no text response."
end

local requestBusy = false

local function setBusy(state)
    requestBusy = state
    SendButton.Active = not state
    InputBox.TextEditable = not state

    if state then
        SendButton.Text = "…"
        SendButton.BackgroundColor3 = Theme.Panel3
        StatusDot.BackgroundColor3 = Color3.fromRGB(246, 190, 73)
        Subtitle.Text = MODEL .. "  •  Thinking..."
    else
        SendButton.Text = "↑"
        SendButton.BackgroundColor3 = Theme.Accent
        StatusDot.BackgroundColor3 = Theme.Success
        Subtitle.Text = MODEL .. (LAST_MODEL and ("  •  " .. LAST_MODEL) or "  •  Ready")
        InputBox.TextEditable = true
    end
end

local function sendMessage()
    if requestBusy then
        return
    end

    local promptText = InputBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
    if promptText == "" then
        return
    end

    -- Local debug command. Avoid placing the entire potentially huge history
    -- into one TextLabel; show exact counts and a recent preview instead.
    if promptText:lower() == "//debugmemory" then
        InputBox.Text = ""

        local totalMessages = math.max(0, #chatHistory - 1)
        local totalCharacters = 0

        for i = 2, #chatHistory do
            totalCharacters += #tostring(chatHistory[i].content or "")
        end

        local preview = {}
        local startIndex = math.max(2, #chatHistory - 19)

        for i = startIndex, #chatHistory do
            local item = chatHistory[i]
            local content = tostring(item.content or "")
            if #content > 500 then
                content = content:sub(1, 500) .. "…"
            end

            table.insert(
                preview,
                tostring(i - 1) .. ". [" .. tostring(item.role) .. "] " .. content
            )
        end

        createMessage(
            "assistant",
            "FULL persistent context is loaded.\n"
                .. "Messages: " .. tostring(totalMessages)
                .. "\nCharacters: " .. tostring(totalCharacters)
                .. "\nPreview (last " .. tostring(#preview) .. "):\n"
                .. (#preview > 0 and table.concat(preview, "\n") or "(empty)")
        )
        return
    end

    InputBox.Text = ""

    local flagged, flagReason = detectPromptInjectionFlag(promptText)

    createMessage("user", promptText)
    local loadingRow, loadingLabel = createMessage("assistant", "Thinking...", true)

    setBusy(true)

    task.spawn(function()
        local aiResponse = callOpenRouter(promptText)

        if loadingRow and loadingRow.Parent then
            loadingRow:Destroy()
        end

        createAssistantResponse(aiResponse, {
            flagged = flagged,
            reason = flagReason,
        })

        setBusy(false)
        scrollToBottom()
        InputBox:CaptureFocus()
    end)
end

